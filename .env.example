# Pree environment contract. Copy to .env for local work; never commit .env.
# Every value is read from the environment at request time. Nothing is baked into the image.

# --- Platform injected. Do NOT set these in the App Store console. ---
# PORT is injected by the platform (containerPort 8080). The code defaults to 8080.
# STORAGE_MOUNT_PATH is injected by the FILE_STORAGE add-on as /data.

# --- Operator set. ---
# Shared team token. Absent means the auth gate is OPEN, which is permitted in development
# only: with PREE_ENV=production and no token the app refuses to start. The server always
# binds 0.0.0.0, never loopback, so an open gate is reachable by anything that can reach
# the port. Set this together with PREE_ALLOWED_ORIGIN.
PREE_TEAM_TOKEN=

# Production CORS origin. Never a wildcard when a token is set.
PREE_ALLOWED_ORIGIN=

# Deployment environment: "development" or "production".
PREE_ENV=development

# Optional explicit data directory. Leave empty to use STORAGE_MOUNT_PATH, then ./data.
PREE_DATA_DIR=

# Build identity, stamped by the release process for the diagnostics read-out.
PREE_BUILD_ID=local
